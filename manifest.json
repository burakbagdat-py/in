{
  "manifest_version": 3,
  "name": "Story Zoom & İndir",
  "version": "1.0.0",
  "description": "Instagram hikayelerini tam çözünürlükte yakınlaştırın ve indirin.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
